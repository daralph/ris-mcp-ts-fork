# Nach .env kopieren – docker compose liest die Datei automatisch. Alles ist optional.

# Zustandsloser Betrieb: keine Sitzungen, kein Verlust beim Neustart, keine Grenze
# von 100 Sitzungen. Empfohlen für LibreChat und andere Hosts ohne interaktive Ansicht.
MCP_STATELESS=false

# Verlangt "Authorization: Bearer <token>" auf /mcp. Leer = offener Endpunkt
# (nötig für eigene Konnektoren in claude.ai, die keinen festen Header senden können).
# Token erzeugen: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Anfragen pro Minute und MCP-Sitzung. Im zustandslosen Betrieb teilen sich alle
# Clients hinter einer IP das Budget (LibreChat = alle Nutzer:innen), dort also erhöhen.
RATE_LIMIT_PER_MINUTE=60

# Browser-Origins, die /mcp aufrufen dürfen, durch Komma getrennt. Leer lassen:
# LibreChat, claude.ai und gehostete Plattformen rufen vom Backend aus auf und
# senden keinen Origin-Header.
ALLOWED_ORIGINS=

# Host-Port für die localhost-Bindung der docker-compose.yml.
HOST_PORT=3000
